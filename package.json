{
  "name": "seile",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^5",
      "convex": "^1.32.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:android": "turbo -F native android",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F @seile/backend dev",
    "dev:setup": "turbo -F @seile/backend dev:setup",
    "check": "oxlint && oxfmt --write"
  },
  "dependencies": {
    "@seile/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@seile/config": "workspace:*",
    "oxfmt": "^0.26.0",
    "oxlint": "^1.41.0",
    "turbo": "^2.6.3"
  },
  "packageManager": "bun@1.3.8"
}
